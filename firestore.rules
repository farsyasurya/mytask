rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Task Security Rules
    match /tasks/{taskId} {
      allow create, read, update, delete: if true;
    }

    // Notification Security Rules
    match /notifications/{notifId} {
      allow create, read, update, delete: if true;
    }

    // Telegram Connections
    match /telegram_connections/{connectionId} {
      allow read, write: if true;
    }

    // Telegram Connection Tokens
    match /telegram_connection_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Telegram Reminders History
    match /telegram_reminders/{reminderId} {
      allow read, write: if true;
    }

    // Legacy Telegram Deep Link Tokens
    match /telegram_links/{linkId} {
      allow read, write: if true;
    }

    // Counters Collection for Sequential IDs
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }
  }
}